{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.easy-idp.com/v1/service.schema.json",
  "title": "Service",
  "description": "A service in the IDP catalog",
  "type": "object",
  
  "required": ["apiVersion", "kind", "metadata", "spec"],
  
  "definitions": {
    "repositoryString": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Git repository URL (string format)"
    },
    "repositoryObject": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Git repository URL"
        },
        "defaultBranch": {
          "type": "string",
          "default": "main"
        },
        "private": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["idp.buckingham.io/v1"],
      "description": "API version of this resource"
    },
    
    "kind": {
      "type": "string",
      "const": "Service",
      "description": "Resource type"
    },
    
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Service name (lowercase, hyphens only)"
        },
        
        "namespace": {
          "type": "string",
          "default": "default",
          "description": "Logical namespace for grouping"
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Key-value labels for filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Non-identifying metadata"
        }
      },
      "additionalProperties": false
    },
    
    "spec": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["service", "library", "tool", "website", "infrastructure", "database", "cache"],
          "description": "Type of service"
        },
        
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief description"
        },
        
        "owner": {
          "type": "string",
          "description": "GitHub org or username"
        },
        
        "teams": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "description": "Teams that own this service"
        },
        
        "primaryTeam": {
          "type": "string",
          "description": "Primary team for on-call (defaults to first in teams array)"
        },
        
        "lifecycle": {
          "type": "string",
          "enum": ["development", "staging", "production", "deprecated"],
          "default": "development",
          "description": "Current lifecycle stage"
        },
        
        "repository": {
          "oneOf": [
            {"$ref": "#/definitions/repositoryString"},
            {"$ref": "#/definitions/repositoryObject"}
          ],
          "description": "Git repository URL (string or object format)"
        },
        
        "metadata": {
          "type": "object",
          "description": "Repository metadata from GitHub/GitLab",
          "properties": {
            "language": {
              "type": "string",
              "description": "Primary programming language"
            },
            "topics": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Repository topics/tags"
            },
            "private": {
              "type": "boolean",
              "description": "Whether repository is private"
            },
            "clone_url": {
              "type": "string",
              "format": "uri",
              "description": "HTTPS clone URL"
            },
            "ssh_url": {
              "type": "string",
              "description": "SSH clone URL"
            },
            "default_branch": {
              "type": "string",
              "description": "Default branch name"
            }
          }
        },
        
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Dependencies on other services (simple string array)"
        },
        
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
              "kind": {"type": "string"},
              "name": {"type": "string"},
              "namespace": {"type": "string"}
            }
          },
          "description": "Dependencies on other resources (structured format)"
        },
        
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Links to external resources (dashboard, docs, runbook, etc.)"
        },
        
        "slos": {
          "type": "object",
          "description": "Service Level Objectives",
          "properties": {
            "availability": {
              "type": "string",
              "description": "Target availability (e.g., 99.9%)"
            },
            "latency_p95": {
              "type": "string",
              "description": "95th percentile latency target (e.g., 200ms)"
            },
            "latency_p99": {
              "type": "string",
              "description": "99th percentile latency target"
            },
            "error_rate": {
              "type": "string",
              "description": "Maximum error rate (e.g., 0.1%)"
            }
          },
          "additionalProperties": true
        },
        
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Searchable tags"
        },
        
        "team": {
          "type": "string",
          "description": "Primary team (single team, legacy format)"
        },
        
        "primary_team": {
          "type": "string",
          "description": "Primary team for on-call (snake_case, current format)"
        }
      },
      "additionalProperties": true
    }
  },
  
  "additionalProperties": false
}
