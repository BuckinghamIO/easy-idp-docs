{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.easy-idp.com/v1/service.schema.json",
  "title": "Service",
  "description": "A service in the IDP catalog",
  "type": "object",
  
  "required": ["apiVersion", "kind", "metadata", "spec"],
  
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["idp.buckingham.io/v1"],
      "description": "API version of this resource"
    },
    
    "kind": {
      "type": "string",
      "const": "Service",
      "description": "Resource type"
    },
    
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Service name (lowercase, hyphens only)"
        },
        
        "namespace": {
          "type": "string",
          "default": "default",
          "description": "Logical namespace for grouping"
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Key-value labels for filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Non-identifying metadata"
        }
      },
      "additionalProperties": false
    },
    
    "spec": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["service", "library", "tool", "website", "infrastructure", "database", "cache"],
          "description": "Type of service"
        },
        
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief description"
        },
        
        "owner": {
          "type": "string",
          "description": "GitHub org or username"
        },
        
        "teams": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "description": "Teams that own this service"
        },
        
        "primaryTeam": {
          "type": "string",
          "description": "Primary team for on-call (defaults to first in teams array)"
        },
        
        "lifecycle": {
          "type": "string",
          "enum": ["development", "staging", "production", "deprecated"],
          "default": "development",
          "description": "Current lifecycle stage"
        },
        
        "repository": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://",
              "description": "Git repository URL"
            },
            "defaultBranch": {
              "type": "string",
              "default": "main"
            },
            "private": {
              "type": "boolean",
              "default": false
            }
          }
        },
        
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
              "kind": {"type": "string"},
              "name": {"type": "string"},
              "namespace": {"type": "string"}
            }
          },
          "description": "Dependencies on other resources"
        },
        
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          },
          "description": "Links to external resources (dashboard, docs, runbook, etc.)"
        },
        
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Searchable tags"
        },
        
        "language": {
          "type": "string",
          "description": "Primary programming language"
        },
        
        "framework": {
          "type": "string",
          "description": "Primary framework"
        }
      },
      "additionalProperties": true
    }
  },
  
  "additionalProperties": false
}
