{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.easy-idp.com/v1/globalvariable.schema.json",
  "title": "GlobalVariable",
  "description": "A global variable available across all workflows",
  "type": "object",
  
  "required": ["apiVersion", "kind", "metadata", "spec"],
  
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["idp.buckingham.io/v1"],
      "description": "API version of this resource"
    },
    
    "kind": {
      "type": "string",
      "const": "GlobalVariable",
      "description": "Resource type"
    },
    
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Variable key (e.g., github_org, cluster_ingress_ip)"
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Key-value labels for filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Non-identifying metadata"
        }
      },
      "additionalProperties": false
    },
    
    "spec": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "key": {
          "type": "string",
          "description": "Variable key (current format, matches metadata.name)"
        },
        
        "value": {
          "type": "string",
          "description": "Variable value"
        },
        
        "description": {
          "type": "string",
          "description": "Human-readable description of what this variable is for"
        },
        
        "secret": {
          "type": "boolean",
          "default": false,
          "description": "Whether this value should be treated as a secret"
        },
        
        "category": {
          "type": "string",
          "enum": ["infrastructure", "deployment", "repository", "dns", "general"],
          "description": "Variable category for organization"
        }
      },
      "additionalProperties": true
    }
  },
  
  "additionalProperties": false
}
