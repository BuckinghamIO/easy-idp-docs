{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.easy-idp.com/v1/team.schema.json",
  "title": "Team",
  "description": "A team in the organization",
  "type": "object",
  
  "required": ["apiVersion", "kind", "metadata", "spec"],
  
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["idp.buckingham.io/v1"],
      "description": "API version of this resource"
    },
    
    "kind": {
      "type": "string",
      "const": "Team",
      "description": "Resource type"
    },
    
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Team identifier (lowercase-with-hyphens)"
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Key-value labels for filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Non-identifying metadata"
        }
      },
      "additionalProperties": false
    },
    
    "spec": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "Human-readable team name (camelCase)"
        },
        
        "display_name": {
          "type": "string",
          "description": "Human-readable team name (snake_case, current format)"
        },
        
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief description of the team's purpose"
        },
        
        "type": {
          "type": "string",
          "const": "team",
          "description": "Resource type identifier"
        },
        
        "members": {
          "oneOf": [
            {
              "type": "array",
              "items": {"type": "string"},
              "description": "Team members (simple email list)"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["username"],
                "properties": {
                  "username": {
                    "type": "string",
                    "format": "email",
                    "description": "User email"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["lead", "member"],
                    "default": "member",
                    "description": "Team role"
                  },
                  "since": {
                    "type": "string",
                    "format": "date",
                    "description": "Date joined team (YYYY-MM-DD)"
                  }
                }
              },
              "description": "Team members (structured format with roles)"
            }
          ],
          "description": "Team members"
        },
        
        "contacts": {
          "type": "object",
          "properties": {
            "slack": {
              "type": "string",
              "description": "Slack channel (e.g., #team-platform or team-platform)"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Team email address"
            },
            "pagerduty": {
              "type": "string",
              "description": "PagerDuty escalation policy or schedule"
            }
          },
          "description": "Contact information"
        },
        
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          },
          "description": "Links to team resources (wiki, jira, calendar, etc.)"
        },
        
        "services": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Services owned by this team (auto-populated)"
        }
      },
      "additionalProperties": true
    }
  },
  
  "additionalProperties": false
}
