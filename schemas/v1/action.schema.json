{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.easy-idp.com/v1/action.schema.json",
  "title": "Action",
  "description": "A custom action definition for workflows",
  "type": "object",
  
  "required": ["apiVersion", "kind", "metadata", "spec"],
  
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["idp.buckingham.io/v1"],
      "description": "API version of this resource"
    },
    
    "kind": {
      "type": "string",
      "const": "Action",
      "description": "Resource type"
    },
    
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Action identifier (e.g., slack.notify, github.create-repo)"
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Key-value labels for filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Non-identifying metadata"
        }
      },
      "additionalProperties": false
    },
    
    "spec": {
      "type": "object",
      "required": ["type", "parameters", "implementation"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Action name (current format, matches metadata.name)"
        },
        
        "version": {
          "type": "string",
          "description": "Action version"
        },
        
        "description": {
          "type": "string",
          "description": "Brief description of what this action does"
        },
        
        "type": {
          "type": "string",
          "enum": ["http_wrapper", "composite", "python", "shell"],
          "description": "Action implementation type"
        },
        
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "array", "object"],
                "description": "Parameter type"
              },
              "required": {
                "type": "boolean",
                "default": false,
                "description": "Whether this parameter is required"
              },
              "default": {
                "description": "Default value if not provided"
              },
              "description": {
                "type": "string",
                "description": "Parameter description"
              }
            }
          },
          "description": "Action parameters"
        },
        
        "implementation": {
          "type": "object",
          "required": ["action"],
          "properties": {
            "action": {
              "type": "string",
              "description": "Underlying action to execute"
            },
            "config": {
              "type": "object",
              "additionalProperties": true,
              "description": "Configuration for the underlying action"
            }
          },
          "description": "Action implementation details"
        },
        
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "Example description"
              },
              "config": {
                "type": "object",
                "additionalProperties": true,
                "description": "Example configuration"
              }
            }
          },
          "description": "Usage examples"
        }
      },
      "additionalProperties": true
    }
  },
  
  "additionalProperties": false
}
