{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.easy-idp.com/v1/integration.schema.json",
  "title": "Integration",
  "description": "An external service integration",
  "type": "object",
  
  "required": ["apiVersion", "kind", "metadata", "spec"],
  
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["idp.buckingham.io/v1"],
      "description": "API version of this resource"
    },
    
    "kind": {
      "type": "string",
      "const": "Integration",
      "description": "Resource type"
    },
    
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Unique identifier (lowercase-with-hyphens, immutable, e.g., github, datadog)"
        },
        
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        
        "description": {
          "type": "string",
          "description": "Brief description of this integration"
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Key-value labels for filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Non-identifying metadata"
        }
      },
      "additionalProperties": false
    },
    
    "spec": {
      "type": "object",
      "required": ["type", "enabled"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["github", "monitoring", "code_quality", "dns_cdn", "cicd", "secrets", "cloud", "container_registry", "custom"],
          "description": "Integration type/category"
        },
        
        "enabled": {
          "type": "boolean",
          "description": "Whether this integration is active"
        },
        
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Integration-specific configuration"
        },
        
        "credentials": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Encrypted credentials (managed by SOPS)"
}
      },
      "additionalProperties": true
    }
  },
  
  "additionalProperties": false
}
