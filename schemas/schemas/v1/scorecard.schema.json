{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.easy-idp.com/v1/scorecard.schema.json",
  "title": "Scorecard",
  "description": "A quality scorecard for evaluating services",
  "type": "object",
  
  "required": ["apiVersion", "kind", "metadata", "spec"],
  
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["idp.buckingham.io/v1"],
      "description": "API version of this resource"
    },
    
    "kind": {
      "type": "string",
      "const": "Scorecard",
      "description": "Resource type"
    },
    
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Unique identifier (lowercase-with-hyphens, immutable)"
        },
        
        "name": {
          "type": "string",
          "description": "Human-readable display name"
        },
        
        "description": {
          "type": "string",
          "description": "Brief description of what this scorecard evaluates"
        },
        
        "applies_to": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Resource kinds this scorecard applies to (e.g., ['service', 'library'])"
        },
        
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Key-value labels for filtering"
        },
        
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Non-identifying metadata"
        }
      },
      "additionalProperties": false
    },
    
    "spec": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Check identifier"
              },
              "title": {
                "type": "string",
                "description": "Human-readable check title"
              },
              "description": {
                "type": "string",
                "description": "Detailed check description"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "default": 1,
                "description": "Weight of this check in total score"
              },
              "check_type": {
                "type": "string",
                "description": "Check implementation type (http, github, metadata, link, etc.)"
              },
              "config": {
                "type": "object",
                "additionalProperties": true,
                "description": "Check-specific configuration"
              },
              "rule": {
                "type": "object",
                "required": ["field", "operator"],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Field to check (e.g., spec.owner)"
                  },
                  "operator": {
                    "type": "string",
                    "enum": ["isNotEmpty", "isEmpty", "equals", "notEquals", "contains", "matches"],
                    "description": "Comparison operator"
                  },
                  "value": {
                    "description": "Value to compare against (for operators that need it)"
                  }
                },
                "description": "Rule to evaluate (future format)"
              }
            }
          },
          "description": "Checks to evaluate"
        },
        
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number",
                "description": "Minimum score for this level"
              },
              "title": {
                "type": "string",
                "description": "Level title"
              },
              "description": {
                "type": "string",
                "description": "Level description"
              }
            }
          },
          "description": "Maturity levels (current format: bronze, silver, gold)"
}
      },
      "additionalProperties": true
    }
  },
  
  "additionalProperties": false
}
